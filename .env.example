# Jobseeking Agent v2 — Environment Variables

# Required: Google Gemini API key
GEMINI_API_KEY=AIza...

# Optional: Push notifications (Telegram Bot API or compatible webhook)
# For Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_CHAT_ID=

# Auto-filter thresholds
HIGH_SCORE_THRESHOLD=0.80   # Score >= 80% → immediate push
MID_SCORE_THRESHOLD=0.70    # Score 70-80% → daily report; < 70% → discard

# Scraper settings
DEFAULT_MAX_JOBS=15

# GitHub MCP profile sync (TASK-B01, see SPEC.md 附录 F.7)
# Personal access token with at least public repo read scope. Used as a
# Bearer token against GitHub's official remote MCP server
# (https://api.githubcopilot.com/mcp/) — read-only tools only.
GITHUB_TOKEN=

# Snowflake (TASK-D04 — Analytics dashboard star-schema ETL, see SPEC.md 附录 E.8)
# Account identifier format: e.g. "xy12345.ap-southeast-2" — find it in the
# Snowflake trial welcome email or Admin > Accounts in the web UI.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=JOBSEEKING_ANALYTICS
SNOWFLAKE_SCHEMA=PUBLIC
